local function isEnemy(plr)
    if plr == LocalPlayer then return false end
    if not Config.SA_IgnoreTeam then return true end
    local ok, same = pcall(function()
        return plr.Team ~= nil and LocalPlayer.Team ~= nil and plr.Team == LocalPlayer.Team
    end)
    return not (ok and same)
end

local function getTarget()
    local aim = getAimPoint()
    local best, bestDist = nil, Config.SA_FOV

    for _, plr in ipairs(Players:GetPlayers()) do
        if isEnemy(plr) and plr.Character then
            local char = plr.Character
            local hum = char:FindFirstChildOfClass("Humanoid")
            if hum and hum.Health > 0 then
                local wanted = Config.SA_Part
                if wanted == "Random" then
                    wanted = (math.random() < 0.5) and "Head" or "HumanoidRootPart"
                end
                local part = char:FindFirstChild(wanted) or char:FindFirstChild("HumanoidRootPart") or char.PrimaryPart
                if part then
                    local v, onScreen = Camera:WorldToViewportPoint(part.Position)
                    if onScreen then
                        local d = (Vector2.new(v.X, v.Y) - aim).Magnitude
                        if d < bestDist then
                            bestDist, best = d, part
                        end
                    end
                end
            end
        end
    end
    return best
end

local hooked = false

-- Надёжная проверка "свой ли это вызов" — не падает если checkcaller отсутствует
local function isOwnCall()
    local ok, res = pcall(function()
        if checkcaller then return checkcaller() end
        return false
    end)
    return ok and res
end

local function installHook()
    if hooked then return true end
    if not hookmetamethod or not getnamecallmethod then
        notify("Executor не поддерживает hookmetamethod", 4)
        return false
    end

    local ok = pcall(function()
        local old
        -- Используем newcclosure напрямую если доступен — это самый надёжный путь для Delta
        local wrapped = function(self, ...)
            local method = getnamecallmethod()
            if Config.SA_Enabled and not isOwnCall() then
                local target = getTarget()
                if target and target.Parent and target.Position then
                    local args = {...}
                    if method == "Raycast" then
                        local origin = args[1]
                        if typeof(origin) == "Vector3" then
                            local dir = args[2]
                            local len = (typeof(dir) == "Vector3" and dir.Magnitude > 0) and dir.Magnitude or 2000
                            local newDir = (target.Position - origin)
                            if newDir.Magnitude > 0.001 then
                                newDir = newDir.Unit * len
                                -- Сохраняем RaycastParams если он есть (3-й аргумент)
                                return old(self, origin, newDir, args[3])
                            end
                        end
                    elseif method == "FindPartOnRay" then
                        local ray = args[1]
                        if typeof(ray) == "Ray" and ray.Direction.Magnitude > 0 then
                            local newDir = (target.Position - ray.Origin)
                            if newDir.Magnitude > 0.001 then
                                local newRay = Ray.new(ray.Origin, newDir.Unit * ray.Direction.Magnitude)
                                return old(self, newRay, args[2], args[3], args[4])
                            end
                        end
                    elseif method == "FindPartOnRayWithIgnoreList" then
                        local ray = args[1]
                        if typeof(ray) == "Ray" and ray.Direction.Magnitude > 0 then
                            local newDir = (target.Position - ray.Origin)
                            if newDir.Magnitude > 0.001 then
                                local newRay = Ray.new(ray.Origin, newDir.Unit * ray.Direction.Magnitude)
                                return old(self, newRay, args[2], args[3], args[4])
                            end
                        end
                    elseif method == "FindPartOnRayWithWhitelist" then
                        local ray = args[1]
                        if typeof(ray) == "Ray" and ray.Direction.Magnitude > 0 then
                            local newDir = (target.Position - ray.Origin)
                            if newDir.Magnitude > 0.001 then
                                local newRay = Ray.new(ray.Origin, newDir.Unit * ray.Direction.Magnitude)
                                return old(self, newRay, args[2], args[3])
                            end
                        end
                    end
                end
            end
            return old(self, ...)
        end

        if newcclosure then
            local wOk, wRes = pcall(newcclosure, wrapped)
            if wOk and wRes then
                old = hookmetamethod(game, "__namecall", wRes)
            else
                old = hookmetamethod(game, "__namecall", wrapped)
            end
        else
            old = hookmetamethod(game, "__namecall", wrapped)
        end
    end)

    if ok then
        hooked = true
        notify("Silent Aim: хук установлен", 2.2)
    else
        notify("Не удалось установить хук Silent Aim", 4)
    end
    return ok
end

