local Tabs, CurrentTab = {}, nil

local function selectTab(tab)
    if CurrentTab == tab then return end
    for _, t in ipairs(Tabs) do
        t.Page.Visible = false
        t.Highlight.BackgroundTransparency = 1
        t.Glow.Enabled = false
        tween(t.Button, nil, {BackgroundColor3 = Palette.Panel})
        tween(t.Label, nil, {TextColor3 = Palette.TextDim})
    end
    tab.Page.Visible = true
    CurrentTab = tab
    tab.Highlight.BackgroundTransparency = 0
    tab.Glow.Enabled = true
    tween(tab.Button, nil, {BackgroundColor3 = Palette.PanelAlt})
    tween(tab.Label, nil, {TextColor3 = Palette.Text})
end

