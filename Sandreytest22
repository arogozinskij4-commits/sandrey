    -- Заполнение — акцентный градиент с внутренним свечением
    local fill = create("Frame", {Size = UDim2.new(a0, 0, 1, 0), BorderSizePixel = 0, Parent = track})
    corner(fill, 3); gradient(fill, 0)
    -- Верхний блик заполнения
    local fillShine = create("Frame", {
        Size = UDim2.new(1, 0, 0, 1),
        Position = UDim2.new(0, 0, 0, 1),
        BackgroundTransparency = 0.4,
        BorderSizePixel = 0,
        Parent = fill
    })
    corner(fillShine, 1)
    create("UIGradient", {
        Rotation = 90,
        Color = ColorSequence.new(Color3.fromRGB(255, 255, 255)),
        Transparency = NumberSequence.new({
            NumberSequenceKeypoint.new(0,   0.5),
            NumberSequenceKeypoint.new(0.5, 0.8),
            NumberSequenceKeypoint.new(1,   1),
        }),
        Parent = fillShine
    })

    -- Мягкое акцентное свечение под knob (появляется при hover/drag)
    local knobAura = create("Frame", {
        Size = UDim2.fromOffset(36, 36),
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.new(a0, 0, 0.5, 0),
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        Parent = track
    })
    corner(knobAura, 18); gradient(knobAura, 0)

    -- Роскошный knob: крупнее, градиент корпуса, акцентное внешнее кольцо, тень, центральная точка
    local knob = create("Frame", {
        Size = UDim2.fromOffset(20, 20),
        Position = UDim2.new(a0, -10, 0.5, -10),
        BackgroundColor3 = Color3.fromRGB(235, 237, 243),
        ZIndex = 3, Parent = track
    })
    corner(knob, 10)
    -- Градиент корпуса knob (сверху светлее — объём)
    create("UIGradient", {
        Rotation = 90,
        Color = ColorSequence.new({
            ColorSequenceKeypoint.new(0,   Color3.fromRGB(248, 250, 255)),
            ColorSequenceKeypoint.new(0.6, Color3.fromRGB(215, 218, 228)),
            ColorSequenceKeypoint.new(1,   Color3.fromRGB(170, 174, 186)),
        }),
        Parent = knob
    })
    -- Акцентное внешнее кольцо
    accentStroke(knob, 1, 0.45)
    -- Тонкая светлая линия-блик сверху knob
    local kShine = create("Frame", {
        Size = UDim2.fromOffset(10, 1),
        Position = UDim2.new(0.5, 0, 0, 3),
        AnchorPoint = Vector2.new(0.5, 0),
        BackgroundTransparency = 0.3,
        BorderSizePixel = 0, ZIndex = 4,
        Parent = knob
    })
    corner(kShine, 1)
    -- Центральная акцентная точка-метка
    local kDot = create("Frame", {
        Size = UDim2.fromOffset(3, 3),
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.new(0.5, 0, 0.5, 0),
        BackgroundTransparency = 0.3,
        BorderSizePixel = 0, ZIndex = 4,
        Parent = knob
    })
    corner(kDot, 2)
    accentize(kDot, "BackgroundColor3")

    -- Мягкая тень под knob
    local kShadow = create("Frame", {
        Size = UDim2.fromOffset(18, 18),
        Position = UDim2.new(a0, -9, 0.5, -7),
        BackgroundColor3 = Palette.Shadow,
        BackgroundTransparency = 0.65,
        BorderSizePixel = 0, ZIndex = 2,
        Parent = track
    })
    corner(kShadow, 9)

    local function setValue(raw, fire, anim)
        local alpha = math.clamp((raw - min) / (max - min), 0, 1)
        local v = min + alpha * (max - min)
        if isInt then v = math.floor(v + 0.5) end
        if anim then
            tween(fill, TweenInfo.new(0.15), {Size = UDim2.new(alpha, 0, 1, 0)})
            tween(knob,  TweenInfo.new(0.15, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {Position = UDim2.new(alpha, -10, 0.5, -10)})
            tween(kShadow, TweenInfo.new(0.15), {Position = UDim2.new(alpha, -9, 0.5, -7)})
            tween(knobAura, TweenInfo.new(0.15), {Position = UDim2.new(alpha, 0, 0.5, 0)})
        else
            fill.Size = UDim2.new(alpha, 0, 1, 0)
            knob.Position = UDim2.new(alpha, -10, 0.5, -10)
            kShadow.Position = UDim2.new(alpha, -9, 0.5, -7)
            knobAura.Position = UDim2.new(alpha, 0, 0.5, 0)
        end
        val.Text = tostring(isInt and math.floor(v) or round(v, 2)) .. (suffix or "")
        if fire ~= false then callback(v) end
    end

    local active = false
    local hovered = false

    -- Hover на knob — увеличение + появление aura
    knob.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch then
            hovered = true
            tween(knob, TweenInfo.new(0.18, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {Size = UDim2.fromOffset(24, 24)})
            tween(knobAura, TweenInfo.new(0.2), {BackgroundTransparency = 0.82, Size = UDim2.fromOffset(42, 42)})
        end
    end)
    knob.InputEnded:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseMovement then
            hovered = false
            if not active then
                tween(knob, TweenInfo.new(0.2, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {Size = UDim2.fromOffset(20, 20)})
                tween(knobAura, TweenInfo.new(0.22), {BackgroundTransparency = 1, Size = UDim2.fromOffset(36, 36)})
            end
        end
    end)

    local function upd(input)
        local alpha = math.clamp((input.Position.X - track.AbsolutePosition.X) / math.max(track.AbsoluteSize.X, 1), 0, 1)
        setValue(min + alpha * (max - min), true, false)
    end
    track.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
            active = true
            -- При активном drag — knob крупнее, aura ярче
            tween(knob, TweenInfo.new(0.15), {Size = UDim2.fromOffset(24, 24)})
            tween(knobAura, TweenInfo.new(0.15), {BackgroundTransparency = 0.78})
            upd(i)
        end
    end)
    knob.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
            active = true
            tween(knob, TweenInfo.new(0.15), {Size = UDim2.fromOffset(24, 24)})
            tween(knobAura, TweenInfo.new(0.15), {BackgroundTransparency = 0.78})
        end
    end)
    UserInputService.InputChanged:Connect(function(i)
        if active and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then upd(i) end
    end)
    UserInputService.InputEnded:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
            active = false
            if not hovered then
                tween(knob, TweenInfo.new(0.2, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {Size = UDim2.fromOffset(20, 20)})
                tween(knobAura, TweenInfo.new(0.25), {BackgroundTransparency = 1, Size = UDim2.fromOffset(36, 36)})
            end
        end
    end)
    setValue(default, false, false)
    return function(v) setValue(v, false, true) end
end

local function addDropdown(parent, labelText, options, defaultIndex, callback)
    local c = create("Frame", {Size = UDim2.new(1, 0, 0, 34), BackgroundTransparency = 1, ZIndex = 4, Parent = parent})
    create("TextLabel", {
        Text = labelText, Font = Enum.Font.GothamSemibold, TextSize = 11.5,
        TextColor3 = Palette.Text, TextXAlignment = Enum.TextXAlignment.Left,
        Size = UDim2.new(1, -152, 1, 0), BackgroundTransparency = 1, ZIndex = 4, Parent = c
    })
    local btn = create("TextButton", {
        Text = options[defaultIndex] .. "   ▾", Font = Enum.Font.GothamBold, TextSize = 11,
        TextColor3 = Palette.Text, Size = UDim2.fromOffset(148, 28),
        Position = UDim2.new(1, -148, 0.5, -14), BackgroundColor3 = Palette.PanelAlt,
        AutoButtonColor = false, ZIndex = 4, Parent = c
    })
    corner(btn, 9); stroke(btn, 1, 0.55)

    local open, list = false, nil
    local function close()
        if list then list:Destroy() list = nil end
        open = false
        c.Size = UDim2.new(1, 0, 0, 34)
    end
    btn.MouseButton1Click:Connect(function()
        if open then close() return end
        open = true
        local h = #options * 26 + 6
        c.Size = UDim2.new(1, 0, 0, 34 + h + 4)
        list = create("Frame", {
            Size = UDim2.fromOffset(148, h), Position = UDim2.new(1, -148, 0, 34),
            BackgroundColor3 = Palette.PanelAlt, ZIndex = 20, Parent = c
        })
        corner(list, 9); stroke(list, 1, 0.5)
        create("UIListLayout", {Padding = UDim.new(0, 2), SortOrder = Enum.SortOrder.LayoutOrder, Parent = list})
        create("UIPadding", {PaddingTop = UDim.new(0, 3), PaddingLeft = UDim.new(0, 3), PaddingRight = UDim.new(0, 3), Parent = list})
        for i, opt in ipairs(options) do
            local item = create("TextButton", {
                Text = "  " .. opt, Font = Enum.Font.GothamMedium, TextSize = 11,
                TextColor3 = Palette.TextDim, TextXAlignment = Enum.TextXAlignment.Left,
                Size = UDim2.new(1, 0, 0, 24), BackgroundColor3 = Palette.PanelAlt,
                BackgroundTransparency = 1, AutoButtonColor = false, ZIndex = 21, Parent = list
            })
            corner(item, 6)
            item.MouseEnter:Connect(function()
                item.BackgroundTransparency = 0.3
                item.TextColor3 = Palette.Text
            end)
            item.MouseLeave:Connect(function()
                item.BackgroundTransparency = 1
                item.TextColor3 = Palette.TextDim
            end)
            item.MouseButton1Click:Connect(function()
                btn.Text = opt .. "   ▾"
                close()
                callback(i, opt)
            end)
        end
    end)
    return btn
end

