-- Тонкий L-уголок (декоративный элемент в углах)
local function cornerMark(parent, pos, size, color)
    local c = create("Frame", {
        Size = size or UDim2.fromOffset(16, 16),
        Position = pos,
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        Parent = parent
    })
    -- Горизонтальная часть
    create("Frame", {
        Size = UDim2.fromOffset(size and size.X.Offset or 16, 1),
        BackgroundColor3 = color or Palette.LineSoft,
        BorderSizePixel = 0,
        Parent = c
    })
    -- Вертикальная часть
    create("Frame", {
        Size = UDim2.fromOffset(1, size and size.Y.Offset or 16),
        BackgroundColor3 = color or Palette.LineSoft,
        BorderSizePixel = 0,
        Parent = c
    })
    return c
end

