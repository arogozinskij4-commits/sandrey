    create("UIGradient", {
        Rotation = 90,
        Color = ColorSequence.new({
            ColorSequenceKeypoint.new(0,   Color3.fromRGB(245, 247, 252)),
            ColorSequenceKeypoint.new(1,   Color3.fromRGB(185, 188, 198)),
        }),
        Parent = knob
    })
    -- Внешнее кольцо — акцентный градиент
    accentStroke(knob, 1, 0.5)
    -- Мягкая тень под knob
    local kShadow = create("Frame", {
        Size = UDim2.fromOffset(18, 18),
        Position = UDim2.fromOffset(1, 3),
        BackgroundColor3 = Palette.Shadow,
        BackgroundTransparency = 0.6,
        BorderSizePixel = 0, ZIndex = 3,
        Parent = track
    })
    corner(kShadow, 9)
    -- Центральная акцентная точка
    local kDot = create("Frame", {
        Size = UDim2.fromOffset(4, 4),
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.new(0.5, 0, 0.5, 0),
        BackgroundTransparency = 0.3,
        BorderSizePixel = 0, ZIndex = 5,
        Parent = knob
    })
    corner(kDot, 2)
    accentize(kDot, "BackgroundColor3")

    local state = default
    local function render(anim)
        local info = anim and TweenInfo.new(0.25, Enum.EasingStyle.Quint, Enum.EasingDirection.Out) or TweenInfo.new(0)
        local knobPos = state and UDim2.new(1, -22, 0.5, -10) or UDim2.new(0, 3, 0.5, -10)
        tween(knob, info, {Position = knobPos})
        tween(kShadow, info, {
            Position = state and UDim2.new(1, -21, 0.5, -7) or UDim2.new(0, 4, 0.5, -7)
        })
        tween(fillG, TweenInfo.new(0.22), {BackgroundTransparency = state and 0.55 or 1})
        tween(glow,  TweenInfo.new(0.22), {BackgroundTransparency = state and 0.88 or 1})
    end

    track.MouseEnter:Connect(function()
        if not state then
            tween(track, nil, {BackgroundColor3 = Color3.fromRGB(32, 34, 40)})
        end
    end)
    track.MouseLeave:Connect(function()
        tween(track, nil, {BackgroundColor3 = Color3.fromRGB(24, 25, 30)})
    end)

    track.MouseButton1Click:Connect(function()
        state = not state
        render(true)
        callback(state)
    end)
    render(false)
    return function(v) state = v render(false) end
end

