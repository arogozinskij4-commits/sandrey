local DistanceEnabled = true

-- Форматирование дистанции
local function formatDistance(dist)
    if dist < 1000 then
        return string.format("%.0fm", dist)
    else
        return string.format("%.1fkm", dist / 1000)
    end
end

-- Создаёт BillboardGui над головой игрока
local function addESP(player)
    if player == LocalPlayer then return end
    if espObjects[player] then return end

    -- Ждём появления персонажа
    local character = player.Character
    if not character then
        character = player.CharacterAdded:Wait()
    end
    
    local head = character:WaitForChild("Head", 10)
    if not head then return end

    -- BillboardGui
    local billboard = Instance.new("BillboardGui")
    billboard.Name = "UsernameESP"
    billboard.Adornee = head
    billboard.Size = UDim2.new(0, 220, 0, 60)
    billboard.StudsOffset = Vector3.new(0, 3, 0)
    billboard.AlwaysOnTop = true
    billboard.LightInfluence = 0
    billboard.MaxDistance = 5000
    billboard.ExtentsOffsetWorldSpace = Vector3.zero
    billboard.Parent = LocalPlayer.PlayerGui  -- ВАЖНО: в PlayerGui!

    -- Фон
    local bg = Instance.new("Frame")
    bg.Size = UDim2.new(1, 0, 1, 0)
    bg.BackgroundColor3 = Color3.fromRGB(15, 15, 25)
    bg.BackgroundTransparency = 0.3
    bg.BorderSizePixel = 0
    bg.Parent = billboard

    local bgCorner = Instance.new("UICorner")
    bgCorner.CornerRadius = UDim.new(0, 6)
    bgCorner.Parent = bg

    local bgStroke = Instance.new("UIStroke")
    bgStroke.Color = Color3.fromRGB(0, 180, 255)
    bgStroke.Thickness = 1.5
    bgStroke.Parent = bg

    -- Текст логина
    local usernameLabel = Instance.new("TextLabel")
    usernameLabel.Size = UDim2.new(1, -10, 0, 20)
    usernameLabel.Position = UDim2.new(0, 5, 0, 2)
    usernameLabel.BackgroundTransparency = 1
    usernameLabel.Text = player.Name
    usernameLabel.TextColor3 = Color3.fromRGB(0, 220, 255)
    usernameLabel.TextSize = 14
    usernameLabel.Font = Enum.Font.GothamBold
    usernameLabel.TextStrokeTransparency = 0.5
    usernameLabel.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
    usernameLabel.Parent = billboard

    -- Текст дистанции
    local distanceLabel = Instance.new("TextLabel")
    distanceLabel.Size = UDim2.new(1, -10, 0, 16)
    distanceLabel.Position = UDim2.new(0, 5, 0, 22)
    distanceLabel.BackgroundTransparency = 1
    distanceLabel.Text = "0m"
    distanceLabel.TextColor3 = Color3.fromRGB(255, 200, 0)
    distanceLabel.TextSize = 12
    distanceLabel.Font = Enum.Font.GothamBold
    distanceLabel.TextStrokeTransparency = 0.5
    distanceLabel.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
    distanceLabel.Parent = billboard

    -- Подпись "username"
    local subLabel = Instance.new("TextLabel")
    subLabel.Size = UDim2.new(1, -10, 0, 14)
    subLabel.Position = UDim2.new(0, 5, 1, -16)
    subLabel.BackgroundTransparency = 1
    subLabel.Text = "username"
    subLabel.TextColor3 = Color3.fromRGB(150, 150, 170)
    subLabel.TextSize = 9
    subLabel.Font = Enum.Font.Gotham
    subLabel.TextStrokeTransparency = 0.8
    subLabel.Parent = billboard

    -- Сохраняем ссылку
    espObjects[player] = {
        billboard = billboard,
        distanceLabel = distanceLabel,
        head = head
    }

    -- Если ESP выключен — сразу скрываем
    if not ESPEnabled then
        billboard.Enabled = false
    end

    -- Если персонаж респавнится — пересоздаём
    player.CharacterAdded:Connect(function(newChar)
        -- Удаляем старый
        if espObjects[player] then
            espObjects[player].billboard:Destroy()
            espObjects[player] = nil
        end
        task.wait(1)
        addESP(player)
    end)
end

-- Удаляет ESP игрока
local function removeESP(player)
    if espObjects[player] then
        espObjects[player].billboard:Destroy()
        espObjects[player] = nil
    end
end

-- Включить ESP для всех
local function enableAll()
    for player, data in pairs(espObjects) do
        data.billboard.Enabled = true
    end
end

-- Выключить ESP для всех
local function disableAll()
    for player, data in pairs(espObjects) do
        data.billboard.Enabled = false
    end
end

-- ============================================
--  Обновление дистанции в реальном времени
-- ============================================

RunService.Heartbeat:Connect(function()
    if not ESPEnabled or not DistanceEnabled then return end
    
    local localChar = LocalPlayer.Character
    if not localChar then return end
    
    local localHead = localChar:FindFirstChild("Head")
    if not localHead then return end
    
    for player, data in pairs(espObjects) do
        if data.head and data.head.Parent then
            local distance = (data.head.Position - localHead.Position).Magnitude
            data.distanceLabel.Text = formatDistance(distance)
            data.distanceLabel.Visible = DistanceEnabled
        end
    end
end)

-- ============================================
--  Обработчики кнопок
-- ============================================

-- Кнопка ESP
ESPBtn.MouseButton1Click:Connect(function()
    ESPEnabled = not ESPEnabled

    if ESPEnabled then
        ESPBtn.Text = "ESP: ON"
        ESPBtn.BackgroundColor3 = Color3.fromRGB(0, 170, 80)
        enableAll()
    else
        ESPBtn.Text = "ESP: OFF"
        ESPBtn.BackgroundColor3 = Color3.fromRGB(170, 40, 40)
        disableAll()
    end
end)

-- Кнопка дистанции
DistBtn.MouseButton1Click:Connect(function()
    DistanceEnabled = not DistanceEnabled

    if DistanceEnabled then
        DistBtn.Text = "Distance: ON"
        DistBtn.BackgroundColor3 = Color3.fromRGB(0, 170, 80)
    else
        DistBtn.Text = "Distance: OFF"
        DistBtn.BackgroundColor3 = Color3.fromRGB(170, 40, 40)
        -- Скрываем все дистанции
        for player, data in pairs(espObjects) do
            data.distanceLabel.Visible = false
        end
    end
end)

-- Кнопка замка (блокировка перемещения)
LockBtn.MouseButton1Click:Connect(function()
    MenuLocked = not MenuLocked
    
    if MenuLocked then
        LockBtn.Text = "🔒"
        TitleText.Text = "🔒 ESP Menu (Locked)"
        MainFrame.Active = false  -- Блокируем перемещение
        MainFrame.Draggable = false
    else
        LockBtn.Text = "🔓"
        TitleText.Text = "🔓 ESP Menu"
        MainFrame.Active = true
        MainFrame.Draggable = true
    end
end)

-- Кнопка сворачивания
MinimizeBtn.MouseButton1Click:Connect(function()
    MenuMinimized = not MenuMinimized
    
    if MenuMinimized then
        MinimizeBtn.Text = "+"
        ButtonContainer.Visible = false
        MainFrame.Size = UDim2.new(0, 280, 0, 40)
        
        -- При сворачивании автоматически блокируем
        MenuLocked = true
        LockBtn.Text = "🔒"
        TitleText.Text = "🔒 ESP Menu (Locked)"
        MainFrame.Active = false
        MainFrame.Draggable = false
    else
        MinimizeBtn.Text = "−"
        ButtonContainer.Visible = true
        MainFrame.Size = UDim2.new(0, 280, 0, 180)
        
        -- При разворачивании разблокируем
        MenuLocked = false
        LockBtn.Text = "🔓"
        TitleText.Text = "🔓 ESP Menu"
        MainFrame.Active = true
        MainFrame.Draggable = true
    end
end)

